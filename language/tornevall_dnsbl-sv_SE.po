msgid "API reply success"
msgstr "API gav lyckat svar"

#: tornevall-wp-dnsbl.php:121
msgid "API authorize response"
msgstr "Svar från API-autentisering"

#: tornevall-wp-dnsbl.php:123
msgid "Failed. Did you save your settings before trying this?"
msgstr "Misslyckades. Har du sparat dina inställningar innan du testat detta?"

#: tornevall-wp-dnsbl.php:126
msgid "Flags updated"
msgstr "Flaggorna har uppdaterats"

#: tornevall-wp-dnsbl.php:127
msgid "Request failure"
msgstr "Förfrågningen misslyckades"

#: tornevall-wp-dnsbl.php:130
msgid "Value must not be empty"
msgstr "Värdet får inte vara tomt"

#: tornevall-wp-dnsbl.php:133
msgid "Removed"
msgstr "Borttagen"

#: tornevall-wp-dnsbl.php:136
msgid "What does the image say (lowercase)?"
msgstr "Vad står det i bilden (små bokstäver)?"

#: tornevall-wp-dnsbl.php:140
msgid "Removal time has been extended to "
msgstr "Avlistningstiden har utökats till "

#: tornevall-wp-dnsbl.php:144
msgid "but with penalties due too high removal count in too short time."
msgstr ""
"men med strafftid på grund av allt för många avlistningar under för kort tid."

#: tornevall-wp-dnsbl.php:149
msgid ""
"API data updated - If you have made any changes in this configuration, you "
"should also save the settings."
msgstr ""
"API-data uppdaterades - Om du har gjort några ändringar i den här "
"konfigurationen bör du också spara inställningarna."

#: tornevall-wp-dnsbl.php:199
msgid "Blacklisted ip address in use"
msgstr "Svartlistad ip-adress används"

#: tornevall-wp-dnsbl.php:217
msgid ""
"Your ip address seem to be blacklisted, so your message is not sent. Click "
"for more information."
msgstr ""
"Din ip-adress ser ut att vara svartlistad, så ditt meddelande skickas inte. "
"Klicka för mer information."

