msgid "Always use API instead of DNS lookups when possible (limited requests)"
msgstr ""
"Använd alltid inbyggt API I stället för DNS-namnuppslagningar, när det är "
"möjligt (begränsat antal förfrågningar)"

#: templates/adminview.php:376
msgid "This mode is incompatible with the plain form mode"
msgstr "Detta läget är ej kompatibelt i läget där AJAX är avstängt"

#: templates/adminview.php:385
msgid "Request remotely resolved hosts"
msgstr "Efterfråga namnupplösta adresser från server"

#: templates/adminview.php:393
